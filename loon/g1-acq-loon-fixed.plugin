#!name = G1 ACQ SKU 管理 (Loon 修复版)
#!desc = Google One iOS SKU 采集与改写。改用旧版 Script 语法，兼容 Loon 3.5.3。默认 discount75；本机管理页 https://one.google.com/g1-sku-report。必须开启 HTTPS 解密并信任证书；只启用一个改写入口，切换后重新连接代理。
#!author = crhywun（原仓库），Loon 适配
#!homepage = https://github.com/crhywun/g1-acq
#!system = iOS,iPadOS,tvOS,macOS
#!tag = Google One,SKU,订阅

[Rule]
# 让 HTTP/3/QUIC 回退到 TCP，确保 MITM 能解密（Loon 3.1.7+）
PROTOCOL,QUIC,REJECT-DROP

[Script]
http-response ^https:\/\/one\.google\.com\/ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.11.0/g1-acq-discount.js, requires-body=true, timeout=30, tag=G1 ACQ 采集与改写, enable=true
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.11.0/g1-sku-report-discount.js, requires-body=true, timeout=30, tag=G1 SKU 管理页, enable=true

[Mitm]
hostname = one.google.com
