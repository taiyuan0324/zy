[Script]
http-response ^https?:\/\/api\.qishui\.com\/luna\/ads\/config script-path=https://raw.githubusercontent.com/taiyuan0324/zy/main/soda/scripts/soda.js?v=4,requires-body=true,max-size=10485760,timeout=30,tag=汽水-广告总配置,enable=true
http-response ^https?:\/\/beta-luna\.douyin\.com\/luna\/advert\/incentive\/config script-path=https://raw.githubusercontent.com/taiyuan0324/zy/main/soda/scripts/soda.js?v=4,requires-body=true,max-size=10485760,timeout=30,tag=汽水-激励配置,enable=true
http-response ^https?:\/\/beta-luna\.douyin\.com\/luna\/advert\/incentive\/retrieve script-path=https://raw.githubusercontent.com/taiyuan0324/zy/main/soda/scripts/soda.js?v=4,requires-body=true,max-size=10485760,timeout=30,tag=汽水-广告素材,enable=true
http-response ^https?:\/\/api\.qishui\.com\/luna\/advert\/incentive\/done script-path=https://raw.githubusercontent.com/taiyuan0324/zy/main/soda/scripts/soda.js?v=4,requires-body=true,max-size=10485760,timeout=30,tag=汽水-领奖回调,enable=true
http-response ^https?:\/\/beta-luna\.douyin\.com\/{1,2}luna\/advert\/fallback\/done\/info script-path=https://raw.githubusercontent.com/taiyuan0324/zy/main/soda/scripts/soda.js?v=4,requires-body=true,max-size=10485760,timeout=30,tag=汽水-兜底token,enable=true
http-request ^https?:\/\/api\.qishui\.com\/luna\/advert\/incentive\/done script-path=https://raw.githubusercontent.com/taiyuan0324/zy/main/soda/scripts/soda.js?v=4,requires-body=true,timeout=30,tag=汽水-领奖请求观测,enable=true

