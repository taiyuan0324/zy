#!name=汽水音乐 · 免广告领时长（离线版）
#!desc=下载本目录整个 local/ 打成 zip 后导入 Loon，无需外网
#!author=海鸥
#!system=ios
#!homepage=https://github.com/taiyuan0324/zy

[Script]
http-response ^https?:\/\/api\.qishui\.com\/luna\/ads\/config script-path=scripts/soda.js,requires-body=true,max-size=10485760,timeout=30,tag=汽水-广告总配置,enable=true
http-response ^https?:\/\/beta-luna\.douyin\.com\/luna\/advert\/incentive\/config script-path=scripts/soda.js,requires-body=true,max-size=10485760,timeout=30,tag=汽水-激励配置,enable=true
http-response ^https?:\/\/beta-luna\.douyin\.com\/luna\/advert\/incentive\/retrieve script-path=scripts/soda.js,requires-body=true,max-size=10485760,timeout=30,tag=汽水-广告素材,enable=true
http-response ^https?:\/\/api\.qishui\.com\/luna\/advert\/incentive\/done script-path=scripts/soda.js,requires-body=true,max-size=10485760,timeout=30,tag=汽水-领奖回调,enable=true
http-response ^https?:\/\/beta-luna\.douyin\.com\/{1,2}luna\/advert\/fallback\/done\/info script-path=scripts/soda.js,requires-body=true,max-size=10485760,timeout=30,tag=汽水-兜底token,enable=true

[MITM]
hostname = api.qishui.com, beta-luna.douyin.com
