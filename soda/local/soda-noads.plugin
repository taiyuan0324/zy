#!name=汽水音乐 · 免广告领时长（离线·新语法）
#!desc=下载整个 local/ 打包 zip 导入 Loon，无需外网
#!author=海鸥
#!system=ios
#!homepage=https://github.com/taiyuan0324/zy
#!loon_version=3.5.1(983)

[Script]
response if ${url} ~= /^https?:\/\/[^\/]+\/luna\/ads\/config/ then script("scripts/soda.js") with tag="汽水-广告总配置", timeout=30, requires_body=true, enable=true
response if ${url} ~= /^https?:\/\/[^\/]+\/luna\/advert\/incentive\/config/ then script("scripts/soda.js") with tag="汽水-激励配置", timeout=30, requires_body=true, enable=true
response if ${url} ~= /^https?:\/\/[^\/]+\/luna\/advert\/incentive\/retrieve/ then script("scripts/soda.js") with tag="汽水-广告素材", timeout=30, requires_body=true, enable=true
response if ${url} ~= /^https?:\/\/[^\/]+\/luna\/advert\/incentive\/done/ then script("scripts/soda.js") with tag="汽水-领奖回调", timeout=30, requires_body=true, enable=true
response if ${url} ~= /^https?:\/\/[^\/]+\/{1,2}luna\/advert\/fallback\/done\/info/ then script("scripts/soda.js") with tag="汽水-兜底token", timeout=30, requires_body=true, enable=true
request if ${url} ~= /^https?:\/\/[^\/]+\/luna\/advert\/incentive\/done/ then script("scripts/soda.js") with tag="汽水-领奖请求观测", timeout=30, requires_body=true, enable=true

[MITM]
hostname = api.qishui.com, beta-luna.douyin.com
