#!name=汽水 · 链路哨兵（只诊断）
#!desc=极宽 URL 匹配，命中即通知并打印真实 URL；诊断时只启用本插件，用完关闭
#!author=海鸥
#!system=ios
#!homepage=https://github.com/taiyuan0324/zy

[Script]
response if ${url} ~= /(qishui|luna|douyin|bytedance|snssdk|bytegecko)/i then script("scripts/sentinel.js") with tag="汽水-哨兵-RESP", timeout=30, requires_body=true, enable=true
request if ${url} ~= /(qishui|luna|douyin|bytedance|snssdk|bytegecko)/i then script("scripts/sentinel.js") with tag="汽水-哨兵-REQ", timeout=30, requires_body=true, enable=true

[MITM]
hostname = *.qishui.com, *.douyin.com, *.douyinpic.com, *.snssdk.com, *.bytedance.net, *.bytegecko.com, api.qishui.com, beta-luna.douyin.com, conf.qishui.com
