#!name=汽水音乐 · 激励广告配置改写（新语法·jsDelivr）
#!desc=Loon 3.5.1(983)+ 新版 Script 语法；jsDelivr CDN 通道
#!author=海鸥
#!system=ios
#!homepage=https://github.com/taiyuan0324/zy

[Script]
response if ${url} ~= /^https?:\/\/api\.qishui\.com\/luna\/ads\/config/ then script("https://cdn.jsdelivr.net/gh/taiyuan0324/zy@main/soda/scripts/soda.js?v=2") with tag="汽水-广告总配置", timeout=30, requires_body=true, enable=true
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/luna\/advert\/incentive\/config/ then script("https://cdn.jsdelivr.net/gh/taiyuan0324/zy@main/soda/scripts/soda.js?v=2") with tag="汽水-激励配置", timeout=30, requires_body=true, enable=true
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/luna\/advert\/incentive\/retrieve/ then script("https://cdn.jsdelivr.net/gh/taiyuan0324/zy@main/soda/scripts/soda.js?v=2") with tag="汽水-广告素材", timeout=30, requires_body=true, enable=true
response if ${url} ~= /^https?:\/\/api\.qishui\.com\/luna\/advert\/incentive\/done/ then script("https://cdn.jsdelivr.net/gh/taiyuan0324/zy@main/soda/scripts/soda.js?v=2") with tag="汽水-领奖回调", timeout=30, requires_body=true, enable=true
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/{1,2}luna\/advert\/fallback\/done\/info/ then script("https://cdn.jsdelivr.net/gh/taiyuan0324/zy@main/soda/scripts/soda.js?v=2") with tag="汽水-兜底token", timeout=30, requires_body=true, enable=true

[MITM]
hostname = api.qishui.com, beta-luna.douyin.com
