#!name = 京东开屏与页面推广净化
#!desc = 面向京东 App 15.9.50+ 的开屏、首页/我的/订单/物流推广楼层清理；兼容旧协议。响应清洗脚本固定到上游提交版本。
#!author = zbsdsb（基于 RuCu6 / Maasea / kelee 原插件适配）；本包仅整理导入入口
#!homepage = https://github.com/zbsdsb/loon-adblock-plugins
#!date = 2026-10-11
#!system = iOS
#!loon_version = 3.2.4
#!tag = 去广告,京东

[Rule]
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT

[Script]
http-response ^https:\/\/api\.m\.jd\.com\/client\.action script-path=https://raw.githubusercontent.com/zbsdsb/loon-adblock-plugins/890f64953efc870d4ca6cc5ec19b048c88ec73bb/JD_remove_ads_v2.js, requires-body=true, tag=京东去广告v2

[MitM]
hostname = api.m.jd.com
