#!name = 汽水音乐去广告与VIP领取保障
#!desc = 修复违规拦截：移除请求体篡改保证100%领取成功，屏蔽开屏与信息流推广
#!author = custom
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Luna.png

[Rule]
# 拦截无用统计和第三方广告追踪
DOMAIN, toblog.ctobsnssdk.com, REJECT
DOMAIN, imp.voiceads.cn, REJECT
DOMAIN, log.snssdk.com, REJECT

[Script]
# 仅对响应体进行广告清洗，绝不篡改客户端上报请求
http-response ^https?:\/\/.*(douyin|qishui)\.com\/luna\/(advert\/splash|card|feed) script-path=qishui_vip.js, requires-body=true, tag=汽水广告净化

[Mitm]
hostname = beta-luna.douyin.com, api.qishui.com, *.douyin.com, *.qishui.com
