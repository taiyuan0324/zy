#!name = 闲鱼开屏与信息流净化 v0.2
#!desc = v0.2：QUIC 回落 TCP、拦截 amdc 上报、补齐同城/订单/详情页推荐接口。需先启用「HTTPDNS 解析拦截（06）」，否则 MitM 不接管，复写全部失效。
#!author = IOS去广告工作区；规则来源参考 ddgksf2013 / 树先生 / Marsdlc
#!homepage = https://github.com/Marsdlc/loon-plugins
#!date = 2026-10-13
#!loon_version = 3.2.4
#!tag = 去广告,闲鱼

[Rule]
# amdc 移动调度：阿里系用它探测路由与投放，阻断可降低 IP 直连概率
AND,((URL-REGEX,"^https?:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch"),(USER-AGENT,"%E9%97%B2%E9%B1%BC*")),REJECT
# QUIC 回落 TCP：HTTP/3 不解密，闲鱼若走 QUIC 则所有复写失效
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,goofish.com)),REJECT
DOMAIN-SUFFIX,iyes.youku.com,REJECT

[Rewrite]
# 开屏广告接口
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.*splash\.ads reject-200
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose(?:[/?]|$) reject-200
# 首页右下角悬浮球 / 策略位
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list(?=[/?]|$) response-body-json-jq '.data.strategies = [{}]'
# 首页顶部 Tab
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.circle\.list(?=[/?]|$) response-body-json-jq '.data.circleList |= (if type == "array" then map(select(.bizCode != "saveMoney")) else . end)'
# 首页信息流：保留普通商品条目
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh(?=[/?]|$) response-body-json-jq '.data.homeTopList |= (if type == "array" then [ .[0] ] else . end) | .data.sections |= (if type == "array" then map(select(.data.bizType == "item")) else . end)'
# 首页闲鱼币入口、发布球等运营配置
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.widget\.refresh\.get(?=[/?]|$) response-body-json-jq '.data.homeTopList = []'
# 搜索填词 / 猜你想搜 / 搜索发现
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade(?=[/?]|$) response-body-json-jq '.data.singleShadeWords = [{}]'
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.item\.search\.activate(?=[/?]|$) response-body-json-jq '.data.cardList = [{}]'
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover(?=[/?]|$) response-body-json-jq 'del(.data.resultList)'
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.item\.search\.activate\/2\.0(?=[/?]|$) reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover\/1\.0(?=[/?]|$) reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.detailpage\.search\.shade\/(?:1\.0)?(?=[/?]|$) reject-dict
# 消息页 / 主页“感兴趣的人”
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend(?=[/?]|$) reject-dict
# 我的页面推广组件与信息流
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.user\.page\.my\.adapter(?=[/?]|$) response-body-json-jq '.data.ability=[] | .data.container.sections |= (if type == "array" then map(select(.sectionBizCode | test("head|user|trade"))) else . end)'
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds(?=[/?]|$) response-body-json-jq 'del(.data.sections)'
# 同城、搜索结果及商品详情底部推荐中的非普通广告卡
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home(?=[/?]|$) response-body-json-jq '.data.sections |= (if type == "array" then map(select(.data.bizType == "item")) else . end)'
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search(?=[/?]|$) response-body-json-jq '.data.resultList |= (if type == "array" then map(select(.data.item.main.clickParam.args.biz_type == "item")) else . end)'
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend(?=[/?]|$) response-body-json-jq '.data.cardList |= (if type == "array" then map(select(.cardData.bizType != "mamaAD")) else . end)'
# 订单详情页横幅 / 顺手买
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.trade\.item\.recommend\.render(?=[/?]|$) reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.trade\.full\.info(?=[/?]|$) response-body-json-jq '.data.components |= (if type == "array" then map(select(.render != "bannerVO")) else . end)'
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.trade\.order\.render\/(?=[/?]|$) response-body-json-jq 'del(.data.bottomBarVO.benefitPointAtmosphere) | .data.components |= (if type == "array" then map(select(.render != "meanTimeBuyVO")) else . end)'
# 这些宝贝超好卖 / 用闲鱼币买更便宜 / 同城顶部横幅
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.resell\.recommendorhotcate(?=[/?]|$) reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.idle\.coin\.nextfresh(?=[/?]|$) reject-dict

[MitM]
hostname = acs.m.goofish.com, g-acs.m.goofish.com
